# Supabase 프로젝트 접속 정보 (Vercel 환경변수에도 같은 값을 넣어야 합니다)
# 대시보드 > Project Settings > API 에서 확인할 수 있습니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Cloudflare Turnstile — 가입 봇 차단 (선택)
# 이 값이 없으면 보안 확인 위젯이 아예 표시되지 않고, 가입은 지금처럼 동작합니다.
# 사이트 키는 공개되어도 되는 값입니다. 비밀 키는 여기가 아니라
# Supabase Dashboard > Authentication > Attack Protection 에 넣으세요.
# 둘은 반드시 함께 켜야 합니다 — Supabase에서만 켜면 모든 가입이 거부됩니다.
VITE_TURNSTILE_SITE_KEY=
